{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "bad_request",
                "details": {},
                "message": "The request could not be processed",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "400 The request could not be processed"
      },
      "CodeExpired": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "code_expired",
                "details": {},
                "message": "The code or link is no longer valid; request a new code",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "422 The code or link is no longer valid; request a new code"
      },
      "CodeInvalid": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "code_invalid",
                "details": {},
                "message": "The code is not correct",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "422 The code is not correct"
      },
      "Conflict": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "conflict",
                "details": {},
                "message": "The request conflicts with the current state of the resource",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "409 The request conflicts with the current state of the resource"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "forbidden",
                "details": {},
                "message": "You do not have permission to perform this action",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "403 You do not have permission to perform this action"
      },
      "InternalError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "internal_error",
                "details": {},
                "message": "An unexpected error occurred",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "500 An unexpected error occurred"
      },
      "NotAcceptable": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "not_acceptable",
                "details": {},
                "message": "The requested response format is not supported",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "406 The requested response format is not supported"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "not_found",
                "details": {},
                "message": "The requested resource was not found",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "404 The requested resource was not found"
      },
      "PayloadTooLarge": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "payload_too_large",
                "details": {},
                "message": "The request body is too large",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "413 The request body is too large"
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "rate_limited",
                "details": {},
                "message": "Too many requests, retry later",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "429 Too many requests, retry later"
      },
      "ServiceUnavailable": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "service_unavailable",
                "details": {},
                "message": "The service is temporarily unavailable",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "503 The service is temporarily unavailable"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "unauthorized",
                "details": {},
                "message": "Authentication is required",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "401 Authentication is required"
      },
      "UnsupportedMediaType": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "unsupported_media_type",
                "details": {},
                "message": "The request content type is not supported",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "415 The request content type is not supported"
      },
      "ValidationError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "validation_error",
                "details": {
                  "field_codes": {
                    "date_of_birth": [
                      "invalid_type"
                    ],
                    "email": [
                      "required",
                      "invalid_format"
                    ]
                  },
                  "fields": {
                    "date_of_birth": [
                      "is invalid"
                    ],
                    "email": [
                      "can't be blank",
                      "has invalid format"
                    ]
                  }
                },
                "message": "Request validation failed",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "422 Request validation failed"
      },
      "VerifiedElsewhere": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "verified_elsewhere",
                "details": {},
                "message": "This email was verified on another device; sign in with a code to continue",
                "request_id": "GHx3kP0vZ8sAAAAB"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "409 This email was verified on another device; sign in with a code to continue"
      }
    },
    "schemas": {
      "CurrentUserResponse": {
        "additionalProperties": false,
        "description": "The authenticated viewer. `user` is the one global SimpleFit user; capabilities such as profiles\nand workspace memberships will be added as sibling fields when they exist.\n",
        "example": {
          "user": {
            "created_at": "2026-10-06T12:00:00Z",
            "id": "6f1c2d3e-4b5a-4c6d-8e7f-90a1b2c3d4e5"
          }
        },
        "properties": {
          "user": {
            "additionalProperties": false,
            "properties": {
              "created_at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "description": "Stable user id.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "id",
              "created_at"
            ],
            "type": "object"
          }
        },
        "required": [
          "user"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "EmailCodeRequest": {
        "additionalProperties": false,
        "example": {
          "email": "fighter@example.com"
        },
        "properties": {
          "email": {
            "description": "Email address; matched in canonical form (ADR 0009).",
            "example": "fighter@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailCodeRequest",
        "type": "object"
      },
      "EmailRegistrationAccepted": {
        "additionalProperties": false,
        "description": "Always returned for a well-formed address, whether or not it already has an account. Keep\n`registration_token` for this registration only (memory or secure storage); a new request replaces it.\n",
        "example": {
          "expires_in_seconds": 600,
          "registration_token": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE",
          "resend_after_seconds": 60
        },
        "properties": {
          "expires_in_seconds": {
            "description": "Lifetime of the code (and link).",
            "example": 600,
            "type": "integer"
          },
          "registration_token": {
            "description": "Opaque token of this registration, held only by the client that started it. Never sent by email.",
            "example": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE",
            "pattern": "^sfg_[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "resend_after_seconds": {
            "description": "Wait at least this long before requesting another code.",
            "example": 60,
            "type": "integer"
          }
        },
        "required": [
          "registration_token",
          "expires_in_seconds",
          "resend_after_seconds"
        ],
        "title": "EmailRegistrationAccepted",
        "type": "object"
      },
      "EmailRegistrationCodeRequest": {
        "additionalProperties": false,
        "example": {
          "code": "123456",
          "refresh_token_transport": "body",
          "registration_token": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE"
        },
        "properties": {
          "code": {
            "description": "The 6-digit code from the email.",
            "example": "123456",
            "pattern": "^[0-9]{6}$",
            "type": "string"
          },
          "refresh_token_transport": {
            "default": "body",
            "description": "How to deliver the refresh token (ADR 0010). `body` (mobile) returns it in JSON. `cookie` (web) sets\nthe `HttpOnly` refresh cookie and requires an allow-listed `Origin` and `x-simplefit-csrf: 1`.\n",
            "enum": [
              "body",
              "cookie"
            ],
            "type": "string"
          },
          "registration_token": {
            "description": "Opaque token of this registration, held only by the client that started it. Never sent by email.",
            "example": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE",
            "pattern": "^sfg_[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "registration_token",
          "code"
        ],
        "title": "EmailRegistrationCodeRequest",
        "type": "object"
      },
      "EmailRegistrationStatus": {
        "additionalProperties": false,
        "description": "* `pending` - waiting for the code.\n* `completed` - verified with this client's code; its session was issued.\n* `verified_elsewhere` - verified through the E01 link on another device. This client is not signed in:\n  request an email sign-in code (`POST /api/auth/email/sign-in`) to continue.\n* `expired` - expired, replaced by a newer request, too many wrong codes, or unknown.\n",
        "example": {
          "status": "pending"
        },
        "properties": {
          "status": {
            "enum": [
              "pending",
              "completed",
              "verified_elsewhere",
              "expired"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "EmailRegistrationStatus",
        "type": "object"
      },
      "EmailRegistrationStatusRequest": {
        "additionalProperties": false,
        "example": {
          "registration_token": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE"
        },
        "properties": {
          "registration_token": {
            "description": "Opaque token of this registration, held only by the client that started it. Never sent by email.",
            "example": "sfg_EXAMPLExREGISTRATIONxTOKENxNOTxAxREALxVALUE",
            "pattern": "^sfg_[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "registration_token"
        ],
        "title": "EmailRegistrationStatusRequest",
        "type": "object"
      },
      "EmailSignInAccepted": {
        "additionalProperties": false,
        "description": "Always returned for a well-formed address. If there is an account for it, a 6-digit sign-in code (E17) is on its way.",
        "example": {
          "expires_in_seconds": 600,
          "resend_after_seconds": 60
        },
        "properties": {
          "expires_in_seconds": {
            "description": "Lifetime of the code (and link).",
            "example": 600,
            "type": "integer"
          },
          "resend_after_seconds": {
            "description": "Wait at least this long before requesting another code.",
            "example": 60,
            "type": "integer"
          }
        },
        "required": [
          "expires_in_seconds",
          "resend_after_seconds"
        ],
        "title": "EmailSignInAccepted",
        "type": "object"
      },
      "EmailSignInCodeRequest": {
        "additionalProperties": false,
        "example": {
          "code": "123456",
          "email": "fighter@example.com",
          "refresh_token_transport": "body"
        },
        "properties": {
          "code": {
            "description": "The 6-digit code from the email.",
            "example": "123456",
            "pattern": "^[0-9]{6}$",
            "type": "string"
          },
          "email": {
            "description": "Email address; matched in canonical form (ADR 0009).",
            "example": "fighter@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "refresh_token_transport": {
            "default": "body",
            "description": "How to deliver the refresh token (ADR 0010). `body` (mobile) returns it in JSON. `cookie` (web) sets\nthe `HttpOnly` refresh cookie and requires an allow-listed `Origin` and `x-simplefit-csrf: 1`.\n",
            "enum": [
              "body",
              "cookie"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "title": "EmailSignInCodeRequest",
        "type": "object"
      },
      "EmailVerificationLinkRequest": {
        "additionalProperties": false,
        "description": "The token from the fragment of the E01 link (`/verify-email#token=...`), sent in the body. The fragment never reaches a server by itself.",
        "example": {
          "token": "sfv_EXAMPLExLINKxTOKENxNOTxAxREALxVALUExxxxxxxx"
        },
        "properties": {
          "token": {
            "example": "sfv_EXAMPLExLINKxTOKENxNOTxAxREALxVALUExxxxxxxx",
            "pattern": "^sfv_[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "EmailVerificationLinkRequest",
        "type": "object"
      },
      "EmailVerificationLinkResult": {
        "additionalProperties": false,
        "description": "`verified`: the email is now verified. `already_verified`: nothing more to do. No one is signed in either way.",
        "example": {
          "status": "verified"
        },
        "properties": {
          "status": {
            "enum": [
              "verified",
              "already_verified"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "EmailVerificationLinkResult",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "description": "Machine-readable error. See the ErrorResponse schema for the contract.",
        "example": {
          "code": "not_found",
          "details": {},
          "message": "The requested resource was not found",
          "request_id": "GHx3kP0vZ8sAAAAB"
        },
        "properties": {
          "code": {
            "description": "Stable snake_case error code. Clients branch on this value, never on `message`.\nNew codes may be added over time; treat unknown codes according to the HTTP status.\nKnown codes: `bad_request`, `unauthorized`, `forbidden`, `not_found`, `not_acceptable`, `conflict`, `verified_elsewhere`, `payload_too_large`, `unsupported_media_type`, `validation_error`, `code_invalid`, `code_expired`, `rate_limited`, `internal_error`, `service_unavailable`.\n",
            "example": "not_found",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Code-specific structured data; an empty object when there is nothing to add.\nFor `validation_error` it is a `ValidationErrorDetails`: `fields` maps each invalid\nfield to human-readable messages and `field_codes` to the matching machine-readable\nreason codes (same order).\n",
            "example": {},
            "type": "object"
          },
          "message": {
            "description": "Human-readable English summary. Not localised; may change without notice.",
            "example": "The requested resource was not found",
            "type": "string"
          },
          "request_id": {
            "description": "Value of the `x-request-id` response header, for support and log correlation.",
            "example": "GHx3kP0vZ8sAAAAB",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Envelope returned with every 4xx and 5xx response. Stack traces and internal details\nare never included.\n",
        "example": {
          "error": {
            "code": "not_found",
            "details": {},
            "message": "The requested resource was not found",
            "request_id": "GHx3kP0vZ8sAAAAB"
          }
        },
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness status of the API process.",
        "example": {
          "service": "simplefit-api",
          "status": "ok"
        },
        "properties": {
          "service": {
            "description": "Service identifier.",
            "enum": [
              "simplefit-api"
            ],
            "type": "string"
          },
          "status": {
            "description": "Always `ok` when the process can serve requests.",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RefreshSessionRequest": {
        "additionalProperties": false,
        "description": "Body transport (mobile and other non-browser clients). Web clients send the refresh cookie instead and no body token.",
        "example": {
          "refresh_token": "sfr_3q2-7wQYz1bYH0Cq5Zf8d9E0aB1cD2eF3gH4iJ5kL6m"
        },
        "properties": {
          "refresh_token": {
            "description": "The refresh token from the last session response. Single use.",
            "pattern": "^sfr_[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshSessionRequest",
        "type": "object"
      },
      "SessionTokens": {
        "additionalProperties": false,
        "description": "Credentials of a SimpleFit session. Send `access_token` as `Authorization: Bearer <token>` until\n`access_token_expires_at`, then refresh. `refresh_token` is present only for the body transport;\nwith the cookie transport it is in the `Set-Cookie` header and never readable by scripts.\n",
        "example": {
          "access_token": "sfa_SFMyNTY.g2gDbQAAACQ.LZ3e0J2s5A",
          "access_token_expires_at": "2026-10-06T12:15:00Z",
          "refresh_token": "sfr_3q2-7wQYz1bYH0Cq5Zf8d9E0aB1cD2eF3gH4iJ5kL6m",
          "refresh_token_expires_at": "2026-11-05T12:00:00Z",
          "refresh_token_transport": "body",
          "token_type": "Bearer"
        },
        "properties": {
          "access_token": {
            "description": "Short-lived SimpleFit access token (opaque to clients).",
            "pattern": "^sfa_",
            "type": "string"
          },
          "access_token_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "refresh_token": {
            "description": "Body transport only. Keep it in platform secure storage.",
            "pattern": "^sfr_[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "refresh_token_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "refresh_token_transport": {
            "description": "Where the refresh token was delivered.",
            "enum": [
              "body",
              "cookie"
            ],
            "type": "string"
          },
          "token_type": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "token_type",
          "access_token",
          "access_token_expires_at",
          "refresh_token_expires_at",
          "refresh_token_transport"
        ],
        "title": "SessionTokens",
        "type": "object"
      },
      "ValidationErrorDetails": {
        "description": "`details` of a `validation_error`. Both maps have the same keys (field names; nested\nfields use dotted paths such as `address.city`) and, per field, the same number of entries\nin the same order: `field_codes[field][i]` is the reason for `fields[field][i]`.\nClients branch on `field_codes`, never on the messages in `fields`. New reason codes may\nbe added; treat unknown ones as `invalid`.\n",
        "example": {
          "field_codes": {
            "date_of_birth": [
              "invalid_type"
            ],
            "email": [
              "required",
              "invalid_format"
            ]
          },
          "fields": {
            "date_of_birth": [
              "is invalid"
            ],
            "email": [
              "can't be blank",
              "has invalid format"
            ]
          }
        },
        "properties": {
          "field_codes": {
            "additionalProperties": {
              "items": {
                "enum": [
                  "required",
                  "invalid_format",
                  "too_short",
                  "too_long",
                  "wrong_length",
                  "out_of_range",
                  "invalid_choice",
                  "invalid_type",
                  "already_exists",
                  "does_not_exist",
                  "must_be_accepted",
                  "does_not_match",
                  "invalid"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "description": "Field name to stable machine-readable reason codes.",
            "type": "object"
          },
          "fields": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Field name to human-readable messages (English, for display and debugging).",
            "type": "object"
          }
        },
        "required": [
          "fields",
          "field_codes"
        ],
        "title": "ValidationErrorDetails",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "SimpleFit access token (`sfa_...`) from `SessionTokens`, valid for 15 minutes and only while\nits session is active. Refresh tokens and provider tokens are never accepted here.\n",
        "scheme": "bearer",
        "type": "http"
      },
      "refreshCookie": {
        "description": "Web refresh token: `HttpOnly; Secure; SameSite=Strict; Path=/api/auth` cookie, sent only to\n`/api/auth/*`. Requests using it must carry an allow-listed `Origin` and `x-simplefit-csrf: 1`.\n",
        "in": "cookie",
        "name": "__Secure-sf_refresh",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Backend API for SimpleFit Boxing: the operating system and professional network for boxing.\n\n## Conventions\n\n* JSON request and response bodies (`application/json`) only.\n* Errors use a single envelope (`ErrorResponse`) with a stable machine-readable `code`;\n  validation errors add per-field reason codes (`ValidationErrorDetails`). Clients branch\n  on codes, never on human-readable messages.\n* Browser clients must be on the API's CORS allow-list (explicit origins, no wildcard).\n* Every response carries an `x-request-id` header; error bodies echo it as `request_id`.\n* Product resources will be served under `/api/v1`. Operational, session (`/api/auth`) and viewer\n  (`/api/me`) endpoints live under `/api`.\n* Authenticated endpoints take `Authorization: Bearer <access_token>`; see `SessionTokens`.\n",
    "title": "SimpleFit API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/auth/email/registrations": {
      "post": {
        "callbacks": {},
        "description": "Starts the email ownership verification of a new account and sends E01 (a 6-digit code and a verification\nlink). Requesting again for the same address replaces the previous code, link and registration token.\n\nThe response is the same for every well-formed address, including addresses that already have an account\n(no email is sent then, and nothing is created): it never reveals whether an account exists. Sign-up never\nturns into sign-in.\n",
        "operationId": "requestEmailRegistration",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCodeRequest"
              }
            }
          },
          "description": "Email address",
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRegistrationAccepted"
                }
              }
            },
            "description": "Verification requested"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Start registration: send an email verification code (E01)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/email/registrations/status": {
      "post": {
        "callbacks": {},
        "description": "For the client that started a registration (it sends its `registration_token`). `verified_elsewhere` means\nthe E01 link verified the email: this client is not signed in and must request an email sign-in code.\n",
        "operationId": "getEmailRegistrationStatus",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRegistrationStatusRequest"
              }
            }
          },
          "description": "Registration token",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRegistrationStatus"
                }
              }
            },
            "description": "Registration state"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "The state of a registration",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/email/registrations/verify": {
      "post": {
        "callbacks": {},
        "description": "Verifies the email of a registration with the 6-digit code from E01. Only the client that started the\nregistration can do this: it sends its `registration_token`. On success the account exists and this client\nreceives the registration's one SF-20 session.\n\n* `code_invalid` - wrong code. After 5 wrong codes the code stops working.\n* `code_expired` - the code expired, was replaced, was already used or stopped working: request a new one.\n* `verified_elsewhere` - the email was verified through the E01 link (possibly on another device). The link\n  never signs anyone in: this client must sign in with an email sign-in code.\n* `conflict` - the address already has an account.\n",
        "operationId": "verifyEmailRegistrationCode",
        "parameters": [
          {
            "description": "Required (value `1`) with `refresh_token_transport: cookie`, together with an allow-listed `Origin`.",
            "in": "header",
            "name": "x-simplefit-csrf",
            "required": false,
            "schema": {
              "enum": [
                "1"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRegistrationCodeRequest"
              }
            }
          },
          "description": "Registration token and code",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            },
            "description": "Session credentials",
            "headers": {
              "set-cookie": {
                "description": "Cookie transport only: the refresh token (`HttpOnly; Secure; SameSite=Strict; Path=/api/auth`).",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/CodeInvalid"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Verify a registration with its code and start its session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/email/sign-in": {
      "post": {
        "callbacks": {},
        "description": "If the address has an account, sends E17 with a 6-digit sign-in code. The response is the same for every\nwell-formed address and never reveals whether an account exists. Requesting again replaces the previous\ncode.\n",
        "operationId": "requestEmailSignIn",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCodeRequest"
              }
            }
          },
          "description": "Email address",
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailSignInAccepted"
                }
              }
            },
            "description": "Sign-in code requested"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Send an email sign-in code (E17)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/email/sign-in/verify": {
      "post": {
        "callbacks": {},
        "description": "Verifies the 6-digit code from E17 and starts an SF-20 session.\n\n* `code_invalid` - wrong code. After 5 wrong codes the code stops working.\n* `code_expired` - the code expired, was replaced, was already used or stopped working: request a new one.\n",
        "operationId": "verifyEmailSignInCode",
        "parameters": [
          {
            "description": "Required (value `1`) with `refresh_token_transport: cookie`, together with an allow-listed `Origin`.",
            "in": "header",
            "name": "x-simplefit-csrf",
            "required": false,
            "schema": {
              "enum": [
                "1"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSignInCodeRequest"
              }
            }
          },
          "description": "Email address and code",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            },
            "description": "Session credentials",
            "headers": {
              "set-cookie": {
                "description": "Cookie transport only: the refresh token (`HttpOnly; Secure; SameSite=Strict; Path=/api/auth`).",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/CodeInvalid"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Sign in with an email sign-in code",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/email/verification-links/verify": {
      "post": {
        "callbacks": {},
        "description": "Verifies the email of a registration with the token from the E01 link fragment\n(`/verify-email#token=...`), from any device. It never signs anyone in: no session is created, neither for\nthis browser nor for the device that started the registration.\n\n`code_expired` - the link expired, was replaced by a newer request or stopped working.\n",
        "operationId": "verifyEmailLink",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationLinkRequest"
              }
            }
          },
          "description": "Link token",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailVerificationLinkResult"
                }
              }
            },
            "description": "Email verified"
          },
          "422": {
            "$ref": "#/components/responses/CodeExpired"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "retry-after": {
                "description": "Seconds until another request is accepted (with `429 rate_limited`).",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Verify an email with the E01 link",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "callbacks": {},
        "description": "Revokes the session identified by the request's credential: the bearer access token, the refresh\ntoken in the body, or the web refresh cookie (cookie requests need an allow-listed `Origin` and\n`x-simplefit-csrf: 1`). The refresh cookie is always cleared.\n\nIdempotent: the response is `204` whether the session was active, already revoked or not\nidentifiable, so it reveals nothing about any session. A revoked session can no longer refresh or\naccess authenticated endpoints.\n",
        "operationId": "logout",
        "parameters": [
          {
            "description": "Required (value `1`) when the refresh token is sent as the web cookie, together with an allow-listed `Origin`.",
            "in": "header",
            "name": "x-simplefit-csrf",
            "required": false,
            "schema": {
              "enum": [
                "1"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "description": "Refresh token (optional, body transport)",
          "required": false
        },
        "responses": {
          "204": {
            "description": "Logged out (or nothing to log out)",
            "headers": {
              "set-cookie": {
                "description": "Cookie transport only: the rotated refresh token (`HttpOnly; Secure; SameSite=Strict; Path=/api/auth`) or its deletion.",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          },
          {
            "refreshCookie": []
          }
        ],
        "summary": "Log out of the current session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/session/refresh": {
      "post": {
        "callbacks": {},
        "description": "Consumes the refresh token and issues a new access token and a new refresh token for the same\nsession. A refresh token works once: presenting a consumed token again revokes its session.\n\n**Transport** (exactly one):\n\n* Mobile/body: send `{\"refresh_token\": \"sfr_...\"}`; the new refresh token is returned in the body.\n* Web/cookie: send the `__Secure-sf_refresh` cookie (no body token), an allow-listed `Origin` and\n  `x-simplefit-csrf: 1`; the new refresh token is set as the cookie and omitted from the body.\n\nEvery invalid, expired, revoked or reused token yields the same `401 unauthorized` (and, for the\ncookie transport, clears the cookie).\n",
        "operationId": "refreshSession",
        "parameters": [
          {
            "description": "Required (value `1`) when the refresh token is sent as the web cookie, together with an allow-listed `Origin`.",
            "in": "header",
            "name": "x-simplefit-csrf",
            "required": false,
            "schema": {
              "enum": [
                "1"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "description": "Refresh token (body transport only)",
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            },
            "description": "New session credentials",
            "headers": {
              "set-cookie": {
                "description": "Cookie transport only: the rotated refresh token (`HttpOnly; Secure; SameSite=Strict; Path=/api/auth`) or its deletion.",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {},
          {
            "refreshCookie": []
          }
        ],
        "summary": "Rotate the refresh token and get a new access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "callbacks": {},
        "description": "Returns `200 ok` while the API process is able to serve requests.",
