# SimpleFit API environment configuration
#
# Copy to `.env` (git-ignored) and fill in values for your environment:
#
#   cp .env.example .env
#   set -a; source .env; set +a      # export into the current shell
#
# The application does not load this file itself. It reads plain environment
# variables in config/runtime.exs, so the same mechanism works locally, in CI
# and in production (where the platform injects variables / secrets).
#
# NEVER commit real values. Only this template belongs in Git.

# =============================================================================
# REQUIRED NOW
# =============================================================================

# PostgreSQL connection URL.
#   prod: required.
#   dev:  optional; overrides the defaults in config/dev.exs
#         (postgres:postgres@localhost/simple_fit_dev).
#   test: ignored on purpose, so tests can never touch this database.
#         Use TEST_DATABASE_URL instead.
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/simple_fit_dev

# Signs and encrypts tokens and other secrets. prod: required, 64+ chars.
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Public hostname of the API, used to build absolute URLs. prod: required.
# PHX_HOST=api.example.com

# HTTP port to listen on. Default: 4000.
# PORT=4000

# Browser origins allowed to call the API (CORS), comma-separated exact
# origins: scheme://host[:port], no paths, no trailing slash, never "*".
#   prod: https origins only; unset = no browser origin allowed (fail closed).
#         Malformed values stop the boot with an explicit error.
#   dev:  default http://localhost:3000 (simplefit-platform `pnpm dev`);
#         setting it replaces the default.
#   test: fixed in config/test.exs.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# =============================================================================
# OPTIONAL (implemented, have safe defaults)
# =============================================================================

# Start the HTTP server when running a release (bin/simple_fit start).
# PHX_SERVER=true

# Database connection pool size. Default: 10.
# POOL_SIZE=10

# Connect to PostgreSQL over IPv6. Default: false.
# ECTO_IPV6=false

# prod only: TLS to PostgreSQL with certificate + hostname verification.
# Default: true. Set to false only for a database reachable exclusively over a
# private network.
# DATABASE_SSL=true

# prod only: serve the interactive API docs (/api/docs) and the OpenAPI
# document (/api/openapi). Default: false. Always on in dev and test.
# API_DOCS_ENABLED=false

# test only: alternative test database. Must name a dedicated test database.
# TEST_DATABASE_URL=ecto://postgres:postgres@localhost:5432/simple_fit_test

# =============================================================================
# PROVIDERS (implemented, read by the application since SF-15)
# =============================================================================
# dev:  optional. Without them the app uses fake storage URLs and logs emails
#       instead of sending them (no accounts needed).
# test: ignored; tests never use real providers or the network.
# prod: always the real providers. Missing values do NOT block boot, but every
#       storage/email operation then fails closed with :configuration_error
#       (and an error log naming the missing variable). Values that are set but
#       malformed fail boot. See docs/architecture/adr/0005.

# --- Object storage: AWS S3 (private bucket, presigned direct uploads) ---
# AWS_REGION=eu-central-1
# AWS_S3_BUCKET=simplefit-media-staging
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Temporary credentials only (STS / assumed role).
# AWS_SESSION_TOKEN=
# Optional prefix to separate environments sharing a bucket. Ends with "/".
# AWS_S3_KEY_PREFIX=staging/
# Optional S3-compatible endpoint, e.g. MinIO in development. https:// in prod.
# AWS_S3_ENDPOINT=http://localhost:9000

# --- Transactional email: Resend ---
# RESEND_API_KEY=
# Default sender; the domain must be verified in Resend.
# EMAIL_FROM=SimpleFit <no-reply@simplefit.example>

# =============================================================================
# OBSERVABILITY (optional everywhere; see docs/architecture/adr/0008)
# =============================================================================
# Without these variables the API runs normally: logs go to stdout, no error
# events are sent and traces are not exported.

# Sentry error tracking (unexpected failures only, sanitized). Unset = off.
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# Deployment environment shared by logs, Sentry and traces
# (default: dev / test / prod from the Mix env).
# SENTRY_ENVIRONMENT=staging
# Release identifier, e.g. the deployed git SHA (default: simplefit-api@<version>).
# SENTRY_RELEASE=simplefit-api@3a23147

# OpenTelemetry traces over OTLP/HTTP (protobuf). Unset endpoint = no export.
# The SDK also honours the other standard OTEL_* variables
# (OTEL_EXPORTER_OTLP_HEADERS for collector auth, OTEL_RESOURCE_ATTRIBUTES).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <collector-token>
# Sampling: every trace by default; e.g. 10% of new traces:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# OPTIONAL / FUTURE PROVIDERS
# =============================================================================
# Placeholders for integrations that are NOT implemented yet. The application
# does not read any of these today; each will be wired in (and validated) by
# the ticket that introduces the integration. See
# docs/architecture/adr/0004-deferred-infrastructure.md.

# --- Sign in with Google ---
# GOOGLE_CLIENT_ID=

# --- Sign in with Apple ---
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# Contents of the .p8 key, newlines escaped as \n. Never commit the .p8 file.
# APPLE_PRIVATE_KEY=


# --- Payments: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Product analytics: PostHog ---
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
