# SimpleFit API environment configuration
#
# Copy to `.env` (git-ignored) and fill in values for your environment:
#
#   cp .env.example .env
#   set -a; source .env; set +a      # export into the current shell
#
# The application does not load this file itself. It reads plain environment
# variables in config/runtime.exs, so the same mechanism works locally, in CI
# and in production (where the platform injects variables / secrets).
#
# NEVER commit real values. Only this template belongs in Git.

# =============================================================================
# REQUIRED NOW
# =============================================================================

# PostgreSQL connection URL.
#   prod: required.
#   dev:  optional; overrides the defaults in config/dev.exs
#         (postgres:postgres@localhost/simple_fit_dev).
#   test: ignored on purpose, so tests can never touch this database.
#         Use TEST_DATABASE_URL instead.
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/simple_fit_dev

# Signs and encrypts tokens and other secrets. prod: required, 64+ chars.
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Public hostname of the API, used to build absolute URLs. prod: required.
# PHX_HOST=api.example.com

# HTTP port to listen on. Default: 4000.
# PORT=4000

# =============================================================================
# OPTIONAL (implemented, have safe defaults)
# =============================================================================

# Start the HTTP server when running a release (bin/simple_fit start).
# PHX_SERVER=true

# Database connection pool size. Default: 10.
# POOL_SIZE=10

# Connect to PostgreSQL over IPv6. Default: false.
# ECTO_IPV6=false

# prod only: TLS to PostgreSQL with certificate + hostname verification.
# Default: true. Set to false only for a database reachable exclusively over a
# private network.
# DATABASE_SSL=true

# prod only: serve the interactive API docs (/api/docs) and the OpenAPI
# document (/api/openapi). Default: false. Always on in dev and test.
# API_DOCS_ENABLED=false

# test only: alternative test database. Must name a dedicated test database.
# TEST_DATABASE_URL=ecto://postgres:postgres@localhost:5432/simple_fit_test

# =============================================================================
# OPTIONAL / FUTURE PROVIDERS
# =============================================================================
# Placeholders for integrations that are NOT implemented yet. The application
# does not read any of these today; each will be wired in (and validated) by
# the ticket that introduces the integration. See
# docs/architecture/adr/0004-deferred-infrastructure.md.

# --- Object storage: AWS S3 (media uploads) ---
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# --- Transactional email: Resend ---
# RESEND_API_KEY=

# --- Sign in with Google ---
# GOOGLE_CLIENT_ID=

# --- Sign in with Apple ---
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# Contents of the .p8 key, newlines escaped as \n. Never commit the .p8 file.
# APPLE_PRIVATE_KEY=

# --- Error tracking: Sentry ---
# SENTRY_DSN=

# --- Payments: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Product analytics: PostHog ---
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
